PickupSynergyRuntime="*res://scripts/runtime/pickup_synergy_runtime.gd"
SeriesLootProgressionRuntime="*res://scripts/runtime/series_loot_progression_runtime.gd"
CompleteSeriesModeRuntime="*res://scripts/runtime/complete_series_mode_runtime.gd"
GameModeRuntime="*res://scripts/runtime/game_mode_runtime.gd"
MainMenuRuntime="*res://scripts/runtime/main_menu_runtime.gd"
MainMenuHubRuntime="*res://scripts/runtime/main_menu_hub_runtime.gd"
ModeAwarePreparationRuntime="*res://scripts/runtime/mode_aware_preparation_runtime.gd"
CombatDifficultyTrainingRuntime="*res://scripts/runtime/combat_difficulty_training_runtime.gd"
TrainingProgressionRuntime="*res://scripts/runtime/training_progression_runtime.gd"
PlayerProgressionProfileRuntime="*res://scripts/runtime/player_progression_profile_runtime.gd"
CosmeticCollectionRuntime="*res://scripts/runtime/cosmetic_collection_runtime.gd"
PurchasedItemsApplicationRuntime="*res://scripts/runtime/purchased_items_application_runtime.gd"
MedievalUIThemeRuntime="*res://scripts/runtime/medieval_ui_theme_runtime.gd"
CinematicMainMenuRuntime="*res://scripts/runtime/cinematic_main_menu_runtime.gd"
PreparationBuildComparisonRuntime="*res://scripts/runtime/preparation_build_comparison_runtime.gd"
CombatAttributeIntegrationRuntime="*res://scripts/runtime/combat_attribute_integration_runtime.gd"
ElementalAdvantageRuntime="*res://scripts/runtime/elemental_advantage_runtime.gd"
TaijifuWebBridge="*res://scripts/runtime/web_platform_bridge_runtime.gd"
TaijifuGamepadTraining="*res://scripts/runtime/gamepad_training_runtime.gd"
TaijifuGamepadExperience="*res://scripts/runtime/gamepad_experience_runtime.gd"
TaijifuControllerMastery="*res://scripts/runtime/controller_mastery_runtime.gd"
TaijifuInputGhostMastery="*res://scripts/runtime/input_ghost_mastery_runtime.gd"
