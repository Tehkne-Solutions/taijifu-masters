; Engine configuration file.
; Taijifu Masters — Protótipo Zero

config_version=5

[application]

config/name="Taijifu Masters"
config/description="Batalhas técnicas Tai, Ji e Fu em arenas manga 2D."
config/version="0.1.0-web"
run/main_scene="res://scenes/main.tscn"
config/features=PackedStringArray("4.3", "GL Compatibility")
config/icon="res://web/taijifu-web-icon.svg"

[autoload]

TgapAssetLoader="*res://scripts/runtime/tgap_asset_loader.gd"
AssetPackRegistry="*res://scripts/runtime/asset_pack_registry.gd"
Pack99BattleVisualRuntime="*res://scripts/runtime/pack_99_battle_visual_runtime.gd"
