; Engine configuration file
; Taijifu Masters — First Playable External Playtest

config_version=5

[application]

config/name="Taijifu Masters"
config/description="Batalhas técnicas Tai, Ji e Fu em arenas manga 2D."
config/version="0.2.3-playtest"
run/main_scene="res://scenes/vertical_slice/first_playable_menu.tscn"
config/features=PackedStringArray("4.3", "GL Compatibility")
config/icon="res://web/taijifu-web-icon.svg"

[autoload]

TgapAssetLoader="*res://scripts/runtime/tgap_asset_loader.gd"
InputBootstrapRuntime="*res://scripts/runtime/input_bootstrap_runtime.gd"
ProceduralArenaPickupRuntime="*res://scripts/runtime/procedural_arena_pickup_runtime.gd"
PickupSynergyRuntime="*res://scripts/runtime/pickup_synergy_runtime.gd"
MedievalUIThemeRuntime="*res://scripts/runtime/medieval_ui_theme_runtime.gd"
CombatAttributeIntegrationRuntime="*res://scripts/runtime/combat_attribute_integration_runtime.gd"
ElementalAdvantageRuntime="*res://scripts/runtime/elemental_advantage_runtime.gd"
FirstPlayableCombatFeelRuntime="*res://scripts/runtime/first_playable_combat_feel_runtime.gd"
PilotFeedbackGuardRuntime="*res://scripts/runtime/pilot_feedback_guard_runtime.gd"
TaijifuWebBridge="*res://scripts/runtime/web_platform_bridge_runtime.gd"

[debug]

gdscript/warnings/inference_on_variant=1

[display]

window/size/viewport_width=1280
window/size/viewport_height=720
window/size/window_width_override=1280
window/size/window_height_override=720
window/stretch/mode="canvas_items"
window/handheld/orientation=1

[rendering]

renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
environment/defaults/default_clear_color=Color(0.035, 0.045, 0.065, 1)

[physics]

common/physics_ticks_per_second=60
