; Engine configuration file.
; Taijifu Masters — Protótipo Zero

config_version=5

[application]

config/name="Taijifu Masters"
config/description="Batalhas técnicas Tai, Ji e Fu em arenas manga 2D."
config/version="0.1.0-web"
run/main_scene="res://scenes/main.tscn"
config/features=PackedStringArray("4.3", "GL Compatibility")
config/icon="res://web/taijifu-web-icon.svg"

[autoload]

AssetPackRegistry="*res://scripts/runtime/asset_pack_registry.gd"

[display]

window/size/viewport_width=1280
window/size/viewport_height=720
window/size/window_width_override=1280
window/size/window_height_override=720
window/stretch/mode="canvas_items"
window/handheld/orientation=1

[rendering]

renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
environment/defaults/default_clear_color=Color(0.035, 0.045, 0.065, 1)

[physics]

common/physics_ticks_per_second=60
