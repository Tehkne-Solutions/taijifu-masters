{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://taijifu.dev/schemas/tgap/registry.schema.json",
  "title": "TGAP Global Pack Registry",
  "type": "object",
  "required": ["schema", "project_id", "registry_version", "packs"],
  "properties": {
    "schema": {"const": "tgap/registry/v1"},
    "project_id": {"type": "string", "pattern": "^[a-z0-9-]+$"},
    "registry_version": {"type": "string", "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)$"},
    "packs": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["pack_id", "root", "version", "asset_class", "integration_order", "dependencies", "compatibility"],
        "properties": {
          "pack_id": {"type": "string", "pattern": "^pack_[a-z0-9_]+$"},
          "root": {"type": "string", "pattern": "^assets/tgap/pack_[a-z0-9_]+$"},
          "version": {"type": "string", "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)(?:-[0-9A-Za-z.-]+)?$"},
          "asset_class": {"enum": ["character", "unit", "vfx", "tile", "prop", "environment", "ui"]},
          "integration_order": {"type": "integer", "minimum": 0},
          "enabled": {"type": "boolean", "default": true},
          "dependencies": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["pack_id", "version"],
              "properties": {
                "pack_id": {"type": "string", "pattern": "^pack_[a-z0-9_]+$"},
                "version": {"type": "string", "pattern": "^(>=|<=|>|<|=|~|\\^)?[0-9]+\\.[0-9]+\\.[0-9]+$"},
                "optional": {"type": "boolean", "default": false}
              },
              "additionalProperties": false
            }
          },
          "compatibility": {
            "type": "object",
            "required": ["tgap", "runtime"],
            "properties": {
              "tgap": {"type": "string", "pattern": "^(>=|<=|>|<|=|~|\\^)?[0-9]+\\.[0-9]+\\.[0-9]+$"},
              "runtime": {"type": "string", "minLength": 1},
              "project": {"type": "string"}
            },
            "additionalProperties": false
          }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
