{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://taijifu.dev/schemas/tgap/pipeline-report.schema.json",
  "title": "TGAP Pipeline Report",
  "type": "object",
  "required": ["tgap_version", "pipeline_passed", "promotion_blocked", "steps"],
  "properties": {
    "tgap_version": {"const": "1.0"},
    "pipeline_passed": {"type": "boolean"},
    "promotion_blocked": {"type": "boolean"},
    "steps": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["name", "passed"],
        "properties": {
          "name": {"type": "string", "minLength": 1},
          "passed": {"type": "boolean"},
          "returncode": {"type": "integer"},
          "report": {"type": ["string", "null"]}
        },
        "additionalProperties": true
      }
    }
  },
  "allOf": [
    {"if": {"properties": {"pipeline_passed": {"const": true}}}, "then": {"properties": {"promotion_blocked": {"const": false}}}},
    {"if": {"properties": {"promotion_blocked": {"const": false}}}, "then": {"properties": {"pipeline_passed": {"const": true}}}}
  ],
  "additionalProperties": true
}
